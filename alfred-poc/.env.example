QLOO_API_KEY=your_hackathon_api_key_here
QLOO_BASE_URL=https://hackathon.api.qloo.com

LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
# Used by offline preset builds and the CLI end-to-end test.
LLM_MODEL=anthropic/claude-sonnet-4.5
# Optional: used only by the live dashboard. Defaults to LLM_MODEL.
LIVE_LLM_MODEL=openai/gpt-4o-mini

# Optional but recommended for the public Nominatim fallback.
# Use a real contact string for your deployment.
ALFRED_NOMINATIM_USER_AGENT=alfred-poc/0.1 (contact: you@example.com)
